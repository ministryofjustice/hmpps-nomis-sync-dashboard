{% extends "../../partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% set pageTitle = applicationName + " - Advances migration" %}
{% set backLinkHref = "/" %}

{% block content %}
  <div class="govuk-grid-row govuk-body">
    <h1 class="govuk-heading-l">Advances migration</h1>

    <div>
      {{ govukButton({
        text: "Start new migration",
        href: "/advances-migration/start",
        isStartButton: true,
        classes: "float-right"
      }) }}
    </div>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full" data-qa="migration-results-div">
        {% if migrations.length %}
          {% set rows = [] %}
          {% for migration in migrations %}
            {% set cellHtml %}
              <div class="govuk-!-margin-bottom-5">
                <div class="govuk-grid-row govuk-!-margin-bottom-2">
                  <div class="govuk-grid-column-two-thirds">
                    <span class="govuk-label--s govuk-!-font-weight-bold">Migration Id: </span>
                    <span data-qa="migration-id" class="govuk-!-margin-left-2">{{ migration.migrationId }}</span>
                  </div>
                  <div class="govuk-grid-column-one-third">
                    <span class="govuk-label--s govuk-!-font-weight-bold">Status: </span>
                    <span data-qa="status" class="govuk-!-margin-left-2">{{ migration.status }}</span>
                  </div>
                </div>

                <div class="govuk-grid-row govuk-!-margin-bottom-2">
                  <div class="govuk-grid-column-full">
                    <span class="govuk-label--s">Started: </span>
                    <span data-qa="whenStarted" class="govuk-!-margin-left-2">{{ migration.whenStarted | formatDate('D MMMM YYYY - HH:mm') }}</span>
                    {% if migration.whenEnded %}
                      <span class="govuk-label--s govuk-!-margin-left-3">Ended: </span>
                      <span data-qa="whenEnded" class="govuk-!-margin-left-2">{{ migration.whenEnded | formatDate('D MMMM YYYY - HH:mm') }}</span>
                    {% endif %}
                  </div>
                </div>
                {% if migration.status == 'STARTED' or migration.status == 'CANCELLED_REQUESTED' %}
                  <div class="govuk-grid-row govuk-!-margin-bottom-2">
                    <div class="govuk-grid-column-full">
                      <a data-qa="progress-link" class="govuk-link" href="/advances-migration/details?migrationId={{ migration.migrationId }}">View progress</a>
                    </div>
                  </div>
                {% endif %}

                <div class="govuk-grid-row govuk-!-margin-bottom-2">
                  <div class="govuk-grid-column-full">
                    <span class="govuk-label--s">Migrated: </span>
                    <span data-qa="migratedCount" class="govuk-!-margin-left-1">{{ migration.recordsMigrated }}</span>
                    <span class="govuk-label--s govuk-!-margin-left-5">Failed: </span>
                    <span data-qa="failedCount" class="govuk-!-margin-left-1">{{ migration.recordsFailed }}</span>
                    <span class="govuk-label--s govuk-!-margin-left-5">Estimated: </span>
                    <span data-qa="estimatedCount" class="govuk-!-margin-left-1">{{ migration.estimatedRecordCount }}</span>
                  </div>
                </div>

                <div class="govuk-grid-row govuk-!-margin-bottom-2">
                  {% if migration.recordsFailed + migration.recordsMigrated < migration.estimatedRecordCount %}
                    <div class="govuk-grid-column-two-thirds">
                      <a data-qa="already-migrated-link" class="govuk-link" target="_blank" href="{{ migration.applicationInsightsLink }}">View Insights</a> for already migrated records
                    </div>
                  {% endif %}
                  {% if migration.recordsFailed > 0 %}
                    <div class="govuk-grid-column-one-third">
                      <a data-qa="failures-link" class="govuk-link" href="/advances-migration/failures?migrationId={{ migration.migrationId }}">View failures</a>
                    </div>
                  {% endif %}
                </div>

                <div class="govuk-grid-row govuk-!-margin-bottom-2">
                  <div class="govuk-grid-column-full govuk-!-margin-bottom-3 govuk-!-margin-top-2">
                    <span class="govuk-label--s govuk-!-font-weight-bold">Migration properties:</span>
                  </div>
                  {% if migration.filterFromDate %}
                    <div class="govuk-grid-column-full">
                      <span class="govuk-label--s">From date:</span>
                      <span data-qa="filterFromDate" class="govuk-!-margin-left-2">{{ migration.filterFromDate | formatDate('D MMMM YYYY') }}</span>
                    </div>
                  {% endif %}
                  {% if migration.filterToDate %}
                    <div class="govuk-grid-column-full">
                      <span class="govuk-label--s">To date:</span>
                      <span data-qa="filterToDate" class="govuk-!-margin-left-2">{{ migration.filterToDate | formatDate('D MMMM YYYY') }}</span>
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endset %}
            {% set rows = (rows.push([{ html: cellHtml }]), rows) %}
          {% endfor %}
          {{ govukTable({ rows: rows }) }}
        {% else %}
          <div class="govuk-!-margin-bottom-5">
            <div class="govuk-grid-row govuk-!-margin-bottom-2">No migration records found</div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}
